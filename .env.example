DB_PORT=55432
# 아래 값은 로컬 개발용입니다. 외부 서비스에서 재사용하지 않습니다.
DB_URL=jdbc:postgresql://localhost:55432/autolog
DB_USERNAME=autolog
DB_PASSWORD=autolog
SERVER_PORT=8080
# Android 로컬 연동: Maven의 -Dspring-boot.run.profiles=emulator 또는 아래 환경변수
# Spring Boot는 이 파일을 자동으로 읽지 않습니다. 셸/IDE 실행 환경에 지정하세요.
# SPRING_PROFILES_ACTIVE=emulator
# SERVER_ADDRESS=0.0.0.0
# 앱 개발용 기본 URL: http://10.0.2.2:8080/ (debug HTTP 허용 필요)

# 심사용 영구·재사용 코드: 지정한 회사/차량에서만 사용하며 기본 비활성화합니다.
# 코드는 8자리 숫자, 두 ID는 기존 테스트 회사와 차량의 UUID로 설정합니다.
# 각 기기 토큰은 기본 90일 유효하며, 코드 비활성화/변경은 신규 연결만 차단합니다.
# 기존 연결까지 중지하려면 해당 차량을 비활성화합니다. 일반 페어링은 10분·1회용입니다.
REVIEW_PAIRING_ENABLED=false
# REVIEW_PAIRING_CODE=
# REVIEW_PAIRING_COMPANY_ID=
# REVIEW_PAIRING_VEHICLE_ID=
