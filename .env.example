DB_PORT=55432
# 아래 값은 로컬 개발용입니다. 외부 서비스에서 재사용하지 않습니다.
DB_URL=jdbc:postgresql://localhost:55432/autolog
DB_USERNAME=autolog
DB_PASSWORD=autolog
SERVER_PORT=8080
# Android 로컬 연동: Maven의 -Dspring-boot.run.profiles=emulator 또는 아래 환경변수
# Spring Boot는 이 파일을 자동으로 읽지 않습니다. 셸/IDE 실행 환경에 지정하세요.
# SPRING_PROFILES_ACTIVE=emulator
# SERVER_ADDRESS=0.0.0.0
# 앱 개발용 기본 URL: http://10.0.2.2:8080/ (debug HTTP 허용 필요)
